@startuml FraudGuard_Use_Case
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Аналитик антифрода" as Analyst
actor "Оператор проверки" as Operator
actor "Разработчик /\nсопровождающий" as Maintainer

rectangle "FraudGuard — консольный прототип" {
  usecase "Загрузить CSV\nтранзакций" as UC1
  usecase "Загрузить историю\nклиентов (опционально)" as UC2
  usecase "Проверить и\nвалидировать записи" as UC3
  usecase "Построить\nпрофили клиентов" as UC4
  usecase "Рассчитать риск-скор\nи решение" as UC5
  usecase "Сформировать полный\nотчёт results.csv" as UC6
  usecase "Сформировать алерты\nREVIEW / BLOCK" as UC7
  usecase "Просмотреть ошибки\nи сводку обработки" as UC8
  usecase "Настроить веса и\nпороги, добавить тесты" as UC9
  usecase "Сравнить результаты\nC++ и Kotlin" as UC10
}

Analyst --> UC1
Analyst --> UC2
Analyst --> UC6
Analyst --> UC7
Analyst --> UC8
Operator --> UC7
Operator --> UC8
Maintainer --> UC9
Maintainer --> UC10

UC1 .> UC3 : <<include>>
UC2 .> UC3 : <<include>>
UC3 .> UC4 : <<include>>
UC4 .> UC5 : <<include>>
UC5 .> UC6 : <<include>>
UC5 .> UC7 : <<include>>
UC3 .> UC8 : <<include>>

note bottom of UC5
Скор 0..100:
0–29 APPROVE; 30–59 REVIEW;
60–100 BLOCK
end note
@enduml
