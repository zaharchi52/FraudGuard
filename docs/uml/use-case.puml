@startuml FraudGuard_Use_Case
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Аналитик" as Analyst
actor "Оператор" as Operator

rectangle "FraudGuard" {
  usecase "Загрузить CSV-файлы" as UC1
  usecase "Запустить анализ" as UC2
  usecase "Посмотреть результаты" as UC3
  usecase "Посмотреть алерты" as UC4
  usecase "Проверить REVIEW" as UC5
  usecase "Одобрить или отклонить" as UC6
  usecase "Сохранить отчёты" as UC7
}

Analyst --> UC1
Analyst --> UC2
Analyst --> UC3
Analyst --> UC4
Analyst --> UC7

Operator --> UC4
Operator --> UC5
Operator --> UC6

UC5 .> UC6 : <<include>>
UC2 .> UC3 : <<include>>
UC2 .> UC7 : <<include>>

@enduml
