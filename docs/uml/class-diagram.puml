@startuml FraudGuard_Class
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

class Transaction {
  transactionId: String
  clientId: String
  amount: Decimal
  currency: String
  timestamp: DateTime
}

class ClientProfile {
  transactionCount: Int
  medianAmount: Decimal
  p95Amount: Decimal
  knownCountries: Set
  knownDevices: Set
}

class RiskFactor {
  code: String
  points: Int
}

class ScoredTransaction {
  riskScore: Int
  engineDecision: String
  factors: List
}

class ScoringEngine {
  buildProfile(history)
  evaluateRisk(transaction, profile)
  decisionForScore(score)
}

class CsvCodec {
  readTransactions(file)
}

class ReportWriter {
  writeResults()
  writeAlerts()
  writeErrors()
}

class LiveTransactionRow {
  workflowStatus: String
  resolveReview(approve)
}

ScoredTransaction *-- Transaction
ScoredTransaction o-- "0..*" RiskFactor
ScoringEngine --> ClientProfile : builds
ScoringEngine --> ScoredTransaction : creates
CsvCodec --> Transaction : reads
ReportWriter --> ScoredTransaction : saves
LiveTransactionRow --> ScoredTransaction : stores

@enduml
